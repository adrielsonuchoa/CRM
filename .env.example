# Banco de dados
# Producao: use uma URL libsql:// do Turso e um token criado no painel/CLI.
# Local: deixe vazio para usar file:sqlite.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=

# Autenticacao local
# Gere AUTH_SECRET com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Usadas apenas pelo comando npm run db:bootstrap-admin
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# OpenRouter / IA
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_MESSAGE_MODEL=

# Geoapify
GEOAPIFY_API_KEY=

# Browser Worker / Chrome CDP
# No Windows, use o atalho "Iniciar CRM-1.bat": ele abre o perfil dedicado
# com CDP e o worker reaproveita a sessao do Instagram que ja estiver logada.
CHROME_CDP_URL=http://localhost:9222
CHROME_USER_DATA_DIR=C:\ChromeCRM
# Opcional: o worker encontra o Chrome instalado automaticamente.
CHROME_EXECUTABLE_PATH=
PROSPECTION_DRY_RUN=true
BROWSER_WORKER_INTERVAL_MS=60000
MAX_FIRST_DMS_PER_DAY=5

# Servico remoto de navegador (para hospedagem serverless, ex.: Vercel)
# Preencha estas 2 APENAS no ambiente da aplicacao web (ex.: variaveis de
# ambiente da Vercel) para que ela encaminhe as acoes de Instagram para o
# servidor persistente acima. NUNCA configure BROWSER_SERVICE_URL no proprio
# servidor que roda "npm run browser-service" (veja o comentario no topo de
# scripts/browser-service.ts).
BROWSER_SERVICE_URL=
BROWSER_SERVICE_TOKEN=
# Porta do servico HTTP acima (usada apenas onde "npm run browser-service" roda)
BROWSER_SERVICE_PORT=8787

# Meta / Instagram Graph API
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
AUTO_REPLY=false
