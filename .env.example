# Configurações do Banco de Dados (Para Vercel/Produção via Turso/LibSQL)
# Em ambiente local, se deixados em branco, o sistema utilizará o arquivo local sqlite.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Configurações OpenAI (Para Inteligência Artificial e Respostas Automáticas)
OPENAI_API_KEY=your_openai_api_key_here

# Configurações Meta / Instagram API (Para envio e recebimento de DMs via Meta API)
META_ACCESS_TOKEN=your_meta_page_or_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
META_WEBHOOK_VERIFY_TOKEN=77e6774df16cf22bf164f10919d22ba5990b5c0c097bd4cd06c2c714ef370bba
META_APP_SECRET=your_meta_app_secret_here

# Opções de Automação
AUTO_REPLY=false
