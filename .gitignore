# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# banco de dados local (dados reais de leads — nunca deve ir pro git)
*.db
*.db-journal
*.db-shm
*.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts
tmp/ 
env.local.download 

# diagnostico local de Chrome/Playwright (perfis de teste e resultados - nunca vai pro git)
scripts/_diag/

# instaladores gerados por cliente (contem segredos: AUTH_SECRET, senha do
# admin, chaves de API, e o Node.js portatil/sqlite.db do pacote) - nunca vai pro git
/dist/
scripts/.node-cache/

# banco local (contem leads e usuarios reais) - cada maquina cria o seu com npm run db:migrate
/sqlite.db
*.db-journal
